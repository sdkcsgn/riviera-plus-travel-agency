generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Tour {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameTr    String
  nameEn    String
  nameDe    String
  nameRu    String
  descTr    String
  descEn    String
  descDe    String
  descRu    String
  category  String
  image     String
  duration  String   @default("Süre seçilebilir")
  pickup    String   @default("Antalya bölgesi")
  priceTry  Int?
  priceEur  Int?
  priceUsd  Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id              Int           @id @default(autoincrement())
  code            String        @unique
  tourId          Int
  tour            Tour          @relation(fields: [tourId], references: [id])
  name            String
  email           String
  phone           String
  date            DateTime
  adults          Int
  children        Int           @default(0)
  note            String?
  totalAmount     Int?
  currency        String        @default("TRY")
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  stripeSessionId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
