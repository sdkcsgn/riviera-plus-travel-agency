generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Tour {
  id        Int      @id @default(autoincrement())
  slug      String   @unique

  nameTr    String
  nameEn    String
  nameDe    String
  nameRu    String

  // Ana sayfadaki kısa açıklamalar
  descTr    String
  descEn    String
  descDe    String
  descRu    String

  category  String
  image     String

  // Mevcut alanlar - geriye dönük uyumluluk için korunuyor
  duration  String   @default("Süre seçilebilir")
  pickup    String   @default("Antalya bölgesi")

  // Detay sayfası - Türkçe
  detailDescTr String @default("")
  locationTr   String @default("")
  durationTr   String @default("")
  includedTr   String @default("")
  excludedTr   String @default("")
  importantTr  String @default("")

  // Detail page - English
  detailDescEn String @default("")
  locationEn   String @default("")
  durationEn   String @default("")
  includedEn   String @default("")
  excludedEn   String @default("")
  importantEn  String @default("")

  // Detailseite - Deutsch
  detailDescDe String @default("")
  locationDe   String @default("")
  durationDe   String @default("")
  includedDe   String @default("")
  excludedDe   String @default("")
  importantDe  String @default("")

  // Страница тура - Русский
  detailDescRu String @default("")
  locationRu   String @default("")
  durationRu   String @default("")
  includedRu   String @default("")
  excludedRu   String @default("")
  importantRu  String @default("")

  priceTry  Int?
  priceEur  Int?
  priceUsd  Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id              Int           @id @default(autoincrement())
  code            String        @unique
  tourId          Int
  tour            Tour          @relation(fields: [tourId], references: [id])
  name            String
  email           String
  phone           String
  date            DateTime
  adults          Int
  children        Int           @default(0)
  note            String?
  totalAmount     Int?
  currency        String        @default("TRY")
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  stripeSessionId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
